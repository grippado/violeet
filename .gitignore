# Rust
/target
**/*.rs.bk

# Cargo.lock was ignored during the fan-out wave so parallel tracks adding deps
# to their own crate never collided on it. The wave is over and it is committed
# now, which is what a workspace with binaries wants anyway.

# Xcode project is generated from app/project.yml by xcodegen — never commit it
app/*.xcodeproj
app/*.xcworkspace
.build/
DerivedData/
*.xcuserstate
xcuserdata/

# SwiftPM
app/.swiftpm/
# Same reasoning as Cargo.lock above: pinned during a fan-out wave only invites
# collisions between parallel tracks. Commit it before we ship a build.
app/Package.resolved

# macOS
.DS_Store

# Runtime state lives in ~/.aiterm, but guard against a stray local copy
/.aiterm/

# Stray logs from running the daemon locally. Scoped rather than global: a bare
# `*.log` silently swallowed docs/spikes/hook-payload.log, which is preserved
# evidence, not runtime noise — and the kind of omission you only notice when
# you go looking for the file and it was never committed.
/*.log
/crates/**/*.log
/app/**/*.log
