{
  "name": "Violeeter",
  "version": "2.0.0",
  "license": "MIT",
  "description": "A violet theme for everything. Dark and light, every colour verified against WCAG AA.",
  "homepage": "https://grippado.github.io/violeeter/",

  "_syntax": [
    "Which palette slot plays which part in code. Written once here and resolved",
    "per variant, so an editor port is a mapping and not a second palette — the",
    "way a theme ends up with a green that is one shade off in one editor is by",
    "someone re-picking it there.",
    "",
    "The choices worth defending: comments take brightBlack, the only slot whose",
    "whole job is to recede without disappearing, which is why it had to clear AA.",
    "Keywords take magenta because that is the house colour and keywords are the",
    "skeleton of a file. Types take cyan and functions blue so that a call and the",
    "thing it returns never share a colour."
  ],
  "syntax": {
    "comment": "brightBlack",
    "docComment": "brightBlack",
    "string": "green",
    "stringEscape": "brightGreen",
    "number": "yellow",
    "boolean": "brightMagenta",
    "constant": "brightMagenta",
    "keyword": "magenta",
    "keywordControl": "magenta",
    "operator": "brightCyan",
    "punctuation": "brightBlack",
    "function": "blue",
    "method": "blue",
    "type": "cyan",
    "class": "cyan",
    "interface": "cyan",
    "namespace": "brightCyan",
    "variable": "foreground",
    "parameter": "brightBlue",
    "property": "brightCyan",
    "tag": "magenta",
    "attribute": "yellow",
    "regexp": "brightGreen",
    "error": "red",
    "warning": "yellow",
    "info": "blue",
    "hint": "brightBlack",
    "added": "green",
    "removed": "red",
    "modified": "blue"
  },

  "variants": {
    "dark": {
      "name": "Violeeter Dark",
      "appearance": "dark",
      "background": "#24203F",
      "foreground": "#D9D6EC",
      "cursor": "#C78BF7",
      "selection": "#3A355E",
      "ui": {
        "surface": "#2B2649",
        "surfaceRaised": "#332D55",
        "border": "#3F3968",
        "lineHighlight": "#2A2547",
        "gutter": "#6C6596",
        "gutterActive": "#B9B3D8",
        "accent": "#C78BF7",
        "onAccent": "#24203F"
      },
      "ansi": {
        "black": "#3A355E",
        "red": "#FF6B81",
        "green": "#6FE39B",
        "yellow": "#F2C97B",
        "blue": "#7FAEFF",
        "magenta": "#C78BF7",
